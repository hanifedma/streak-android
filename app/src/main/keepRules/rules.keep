# Add project specific R8 rules here.
# AGP will combine all keep rule files in src/main/keepRules to pass to R8
#
# For more details, see
#   https://d.android.com/r/tools/r8/keep-rules

# Glance instantiates ActionCallback implementations reflectively, through
# their no-argument constructor — nothing in our own code ever constructs one.
# R8 sees that, keeps the class (its name is written into the action intent)
# and strips the constructor, which fails only at runtime and only in a
# minified build:
#
#   java.lang.NoSuchMethodException:
#       com.hanifedma.streak.widget.ToggleHabitAction.<init> []
#
# The symptom is quiet and easy to misread: the widget renders perfectly and
# tapping a habit just does nothing at all. Keeping the constructor is what
# makes widget taps work in release.
-keep class * implements androidx.glance.appwidget.action.ActionCallback {
    <init>();
}

# WorkManager builds Workers by reflection from the class name it persisted in
# its database, so the same trap applies — and here a stripped constructor
# would break the widget's background refresh rather than its taps.
-keep class * extends androidx.work.ListenableWorker {
    <init>(android.content.Context, androidx.work.WorkerParameters);
}