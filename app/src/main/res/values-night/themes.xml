<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Streak defaults to dark regardless of system setting, so the launch
         window stays dark here too — matching the first composed frame. -->
    <style name="Theme.Streak" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/streak_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
        <item name="postSplashScreenTheme">@style/Theme.Streak.Main</item>
    </style>
</resources>
